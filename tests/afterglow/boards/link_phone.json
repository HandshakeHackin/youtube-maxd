   "expect": {"screen": "link_phone", "focus": "code", "rail_open": 0, "state": {"sheet": "0"}}
  },
  {
   "name": "link_phone-not-in-this-build",
   "fixture": "guest-only",
   "route": {"screen": "link_phone"},
   "steps": [{"press": "cross"}, {"press": "square"}, {"press": "options"}, {"wait": 0.4}],
   "expect": {"screen": "link_phone", "focus": "unavailable", "state": {"state": "unavailable", "sheet": "0"}}
  },
  {
   "name": "link_phone-long-texts",
   "fixture": "long-texts",
   "route": {"screen": "link_phone"},
   "settle": 4.3,
   "expect": {"screen": "link_phone", "focus": "code", "state": {"state": "ready", "code": "482913057", "devices": "3"}}
  },
  {
   "name": "link_phone-long-texts-more",
   "fixture": "long-texts",
   "route": {"screen": "link_phone"},
   "settle": 2.5,
   "steps": [{"press": "options"}, {"wait": 0.8}],
   "expect": {"screen": "link_phone", "focus": "option/disconnect"}
  },
  {
   "name": "link_phone-loading",
   "fixture": "signed-in",
   "source": {"hold": true},
   "route": {"screen": "link_phone"},
   "expect": {"screen": "link_phone", "focus": "code", "state": {"load": "loading"}}
  },
  {
   "name": "link_phone-offline",
   "fixture": "signed-in",
   "source": {"offline": true},
   "route": {"screen": "link_phone"},
   "expect": {"screen": "link_phone", "focus": "action/retry", "state": {"load": "offline"}}
  },
  {
   "name": "link_phone-failed",
   "fixture": "broken",
   "route": {"screen": "link_phone"},
   "steps": [{"press": "cross"}, {"wait": 0.8}],
   "expect": {"screen": "link_phone", "focus": "action/retry", "state": {"load": "failed"}}
  },
  {
   "name": "link_phone-rail",
   "fixture": "signed-in",
   "route": {"screen": "link_phone"},
   "settle": 2.5,
   "steps": [{"press": "left"}, {"wait": 0.5}],
   "expect": {"screen": "link_phone", "rail_open": 1}
  },
  {
   "name": "link_phone-reduced-motion",
   "fixture": "signed-in",
   "reduced_motion": true,
   "route": {"screen": "link_phone"},
   "settle": 2.5,
   "expect": {"screen": "link_phone", "focus": "code", "state": {"state": "ready"}}
  }
 ]
}
