  {
   "name": "subscriptions-less-motion",
   "fixture": "signed-in",
   "reduced_motion": true,
   "route": {"screen": "subscriptions"},
   "steps": [{"press": "down"}, {"press": "down", "wait": 0.2}],
   "expect": {"screen": "subscriptions", "focus": "feed/8", "state": {"scroll": "936"}}
  }
 ]
