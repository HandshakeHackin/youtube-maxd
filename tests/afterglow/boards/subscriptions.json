  {
   "name": "subscriptions-to-channel-and-back",
   "fixture": "signed-in",
   "route": {"screen": "subscriptions"},
   "steps": [{"press": "up"}, {"press": "right"}, {"press": "right"}, {"press": "cross"}, {"wait": 0.9}, {"press": "circle"}, {"wait": 0.9}],
