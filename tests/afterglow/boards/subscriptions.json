  {
   "name": "subscriptions-loading",
   "fixture": "signed-in",
   "source": {"hold": true},
   "route": {"screen": "subscriptions"},
   "expect": {"screen": "subscriptions", "focus": "state/loading", "state": {"mode": "loading", "load": "loading"}}
