  {
   "name": "subscriptions-guest-discover",
   "fixture": "guest",
   "route": {"screen": "subscriptions"},
   "steps": [{"press": "right"}, {"press": "cross"}, {"wait": 0.7}],
   "expect": {"screen": "home"}
