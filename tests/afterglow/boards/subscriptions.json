   "route": {"screen": "subscriptions"},
   "expect": {"screen": "subscriptions", "focus": "state/retry", "state": {"mode": "trouble", "load": "offline"}}
  },
  {
   "name": "subscriptions-kept",
   "fixture": "offline",
   "route": {"screen": "subscriptions"},
   "expect": {"screen": "subscriptions", "focus": "state/retry", "state": {"mode": "kept", "load": "offline", "strip": "3", "zone": "notice"}}
