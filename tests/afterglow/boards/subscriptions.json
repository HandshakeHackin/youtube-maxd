  {
   "name": "subscriptions-empty",
   "fixture": "empty", "profile": {"id": "mara", "name": "Mara", "guest": false, "signed_in": true},
   "route": {"screen": "subscriptions"},
   "expect": {"screen": "subscriptions", "focus": "state/search", "state": {"mode": "empty", "load": "ready"}}
  },
  {
   "name": "subscriptions-offline",
   "fixture": "signed-in",
