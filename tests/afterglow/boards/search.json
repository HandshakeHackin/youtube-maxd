   "fixture": "signed-in",
   "route": {"screen": "search"},
   "expect": {"screen": "search", "focus": "key/1", "rail_open": 0, "state": {"zone": "keys", "text": "", "list": "recent", "rows": "5", "recent": "6", "matches": "10", "matches_load": "ready"}, "asked": ["search-history", "section:trending"]}
