{
  "about": "First release does not expose a Notifications rail entry or poll notification counts. Direct Library notification routing remains available.",
  "boards": [
    {
      "name": "notification-count-disabled-signed-in",
      "fixture": "d-signed-in",
      "route": {
        "screen": "home"
      },
      "steps": [
        {
          "wait": 61
        }
      ],
      "expect": {
        "notification_unseen": -1,
        "unasked": [
          "library:notification-count"
        ]
      }
    },
    {
      "name": "notification-count-library-route-no-background-badge",
      "fixture": "d-signed-in",
      "route": {
        "screen": "notifications"
      },
      "expect": {
        "screen": "notifications",
        "state": {
          "unread": "3"
        },
        "unasked": [
          "library:notification-count"
        ]
      }
    },
    {
      "name": "notification-count-rail-skips-notifications",
      "fixture": "d-signed-in",
      "route": {
        "screen": "home"
      },
      "steps": [
        {
          "press": "left"
        },
        {
          "press": "down"
        },
        {
          "press": "down"
        },
        {
          "press": "down"
        },
        {
          "press": "down"
        }
      ],
      "expect": {
        "focus": "rail/settings",
        "rail_open": 1,
        "unasked": [
          "library:notification-count"
        ]
      }
    }
  ]
}
