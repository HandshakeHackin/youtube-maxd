<rml>
<head><link type="text/rcss" href="youtube.rcss"/></head>
<body data-model="youtube">
    <div id="tube-root">
        <div id="tube-header">
            <div id="tube-brand"><span id="tube-mark"><img src="tube-mark.png"/><span id="tube-mark-core"></span></span> ProsperoTube</div>
            <div id="tube-location">{{ breadcrumb }}</div>
            <div id="tube-pager">{{ page_info }}</div>
        </div>
        <div id="tube-status" data-if="status != ''" data-class-error="has_error">{{ status }}</div>
        <div id="tube-loading" data-if="loading">Connecting to your companion… Circle to cancel.</div>
        <div id="tube-empty" data-if="empty &amp;&amp; !loading">
            <div class="empty-title">Nothing here yet</div>
            <div class="empty-note" data-if="!discussion">Square to search. Triangle saves a video. Options pairs your companion.</div>
            <div class="empty-note" data-if="discussion &amp;&amp; !chat">No comments returned. Circle to return. R3 changes comment sorting.</div>
            <div class="empty-note" data-if="chat">No messages on this page. Triangle loads more replay messages; L1 / R1 move replay by one minute. Live chat refreshes automatically.</div>
            <button id="tv-card-setup-url" class="tv-setup-card" data-if="!discussion" data-event-click="setup_url()">PAIR COMPANION</button>
        </div>
        <div id="tube-grid" data-if="!empty" data-class-discussion="discussion || review">
            <div class="tube-card" data-for="row : rows" data-attr-rowid="row.id" data-attr-rowkey="row.selection_key"
                 data-event-click="activate()" data-class-folder="row.is_folder">
                <div class="tube-image" data-if="!discussion &amp;&amp; !review">
                    <img data-if="row.art != ''" data-attr-src="row.art"/>
                    <div class="tube-placeholder" data-if="row.art == '' &amp;&amp; row.id != 'account:notice:version'">{{ row.initial }}</div>
                    <div class="tube-about-mark" data-if="row.id == 'account:notice:version'"><img src="tube-mark-large.png"/><div></div></div>
                    <div class="tube-badge" data-if="row.is_live">LIVE</div>
                    <div class="tube-duration" data-if="row.duration != ''">{{ row.duration }}</div>
                </div>
                <div class="tube-card-title">{{ row.title }}</div>
                <div class="tube-card-author">{{ row.subtitle }}</div>
                <div class="tube-progress" data-if="row.progress > 0"><div data-style-width="row.progress_w"></div></div>
                <div class="tube-watched" data-if="row.played">WATCHED</div>
            </div>
        </div>
        <div id="tube-preview" data-if="has_selected" data-class-discussion="discussion || review">
            <div id="tube-selected-title">{{ selected_title }}</div>
            <div id="tube-selected-detail">{{ selected_subtitle }} · {{ selected_resume }}</div>
            <div id="tube-selected-overview" data-if="!discussion &amp;&amp; !review">{{ selected_overview }}</div>
            <div id="tube-discussion-text" data-if="discussion || review">{{ selected_overview }}</div>
        </div>
        <div id="tube-footer" data-if="!discussion &amp;&amp; !review">
            <span class="tube-key">✕</span> Watch / open
            <span class="tube-key">□</span> Search
            <span class="tube-key">HOLD L3</span> Voice search (experimental)
            <span class="tube-key">△</span> Favorite
            <span class="tube-key">R2</span> Queue
            <span class="tube-key">L2</span> Follow
            <span class="tube-key">L1 / R1</span> Page
            <span class="tube-key">R3</span> Comments / live chat
            <span class="tube-key">TOUCHPAD</span> Actions
            <span class="tube-key">OPTIONS</span> Companion
            <span class="tube-key">○</span> Back
        </div>
        <div id="tube-discussion-footer" data-if="discussion &amp;&amp; !chat">
            <span class="tube-key">✕</span> Replies
            <span class="tube-key">L2 / R2</span> Scroll comment
            <span class="tube-key">L1 / R1</span> Page
            <span class="tube-key">R3</span> Top / newest
            <span class="tube-key">△</span> Chat replay
            <span class="tube-key">Touchpad</span> Rate comment
            <span class="tube-key">○</span> Back
        </div>
        <div id="tube-chat-footer" data-if="chat">
            <span class="tube-key">L2 / R2</span> Scroll message
            <span class="tube-key">L1 / R1</span> Page / replay time
            <span class="tube-key">△</span> More replay messages
            <span class="tube-key">R3</span> Top / live
            <span class="tube-key">Touchpad</span> Comments
            <span class="tube-key">○</span> Back
        </div>
        <div id="tube-description-footer" data-if="description">
            <span class="tube-key">L2 / R2</span> Scroll description
            <span class="tube-key">✕</span> Open channel
            <span class="tube-key">○</span> Back
        </div>
        <div id="tube-review-footer" data-if="review &amp;&amp; !auth &amp;&amp; !description">
            <span class="tube-key">✕</span> Confirm account change
            <span class="tube-key">L2 / R2</span> Scroll details
            <span class="tube-key">○</span> Back without submitting
        </div>
        <div id="tube-auth-footer" data-if="auth">
            Status checked automatically
            <span class="tube-key">✕</span> Choose
            <span class="tube-key">○</span> Back / cancel pending sign-in
        </div>
    </div>
</body>
</rml>
